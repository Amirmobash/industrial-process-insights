{
  "dataRoles": [
    {
      "displayName": "Messwerte",
      "description": "Mindestens zwei numerische Spalten hinzufügen",
      "kind": "GroupingOrMeasure",
      "name": "Values"
    },
    {
      "displayName": "Punktbeschriftungen",
      "description": "Kurze Beschriftung pro Messpunkt (optional)",
      "kind": "GroupingOrMeasure",
      "name": "PointLabels"
    },
    {
      "displayName": "Kurzinfos",
      "kind": "GroupingOrMeasure",
      "description": "Weitere Felder für Kurzinfos",
      "name": "Tooltips"
    },
    {
      "displayName": "ID",
      "description": "Eindeutige Kennung gegen das Entfernen identischer Zeilen (optional)",
      "kind": "GroupingOrMeasure",
      "name": "ID"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "Values": {
            "max": 10
          },
          "PointLabels": {
            "max": 1
          },
          "Tooltips": {
            "max": 2
          },
          "ID": {
            "max": 1
          }
        }
      ],
      "scriptResult": {
        "dataInput": {
          "table": {
            "rows": {
              "select": [
                {
                  "for": {
                    "in": "Values"
                  }
                },
                {
                  "for": {
                    "in": "PointLabels"
                  }
                },
                {
                  "for": {
                    "in": "Tooltips"
                  }
                },
                {
                  "for": {
                    "in": "ID"
                  }
                }
              ],
              "dataReductionAlgorithm": {
                "top": {}
              }
            }
          }
        },
        "script": {
          "scriptProviderDefault": "R",
          "scriptOutputType": "html",
          "source": {
            "objectName": "rcv_script",
            "propertyName": "source"
          },
          "provider": {
            "objectName": "rcv_script",
            "propertyName": "provider"
          }
        }
      }
    }
  ],
  "objects": {
    "rcv_script": {
      "properties": {
        "provider": {
          "type": {
            "text": true
          }
        },
        "source": {
          "type": {
            "scripting": {
              "source": true
            }
          }
        }
      }
    },
    "settings_prepocessing_params": {
      "displayName": "Datenvorverarbeitung",
