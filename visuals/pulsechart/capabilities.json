  "dataViewMappings": [
    {
      "conditions": [
        {
          "Timestamp": {
            "max": 1
          },
          "Value": {
            "max": 1
          },
          "Category": {
            "max": 1
          },
          "EventTitle": {
            "max": 1
          },
          "EventDescription": {
            "max": 1
          },
          "EventSize": {
            "max": 1
          },
          "RunnerCounter": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "Timestamp"
              }
            },
            {
              "bind": {
                "to": "EventTitle"
              }
            },
            {
              "bind": {
                "to": "EventDescription"
              }
            },
            {
              "bind": {
                "to": "RunnerCounter"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 10000
            }
          }
        },
        "values": {
          "group": {
            "by": "Category",
            "select": [
              {
                "bind": {
                  "to": "Value"
                }
              },
              {
                "bind": {
                  "to": "EventSize"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {}
            }
          }
        }
      }
    }
  ],
